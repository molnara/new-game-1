FROM mcr.microsoft.com/dotnet/sdk:10.0

ARG GODOT_VERSION=4.7.2
ARG USERNAME=dev
ARG UID=1000
ARG GID=1000

# Base tools + Godot runtime libs + software rendering (Xvfb + Mesa)
RUN apt-get update && apt-get install -y --no-install-recommends \
      git curl wget unzip zip ca-certificates \
      ripgrep jq less procps nano imagemagick \
      libx11-6 libxcursor1 libxinerama1 libxrandr2 libxi6 \
      libgl1 libegl1 libxkbcommon0 libfontconfig1 libasound2t64 libpulse0 \
      xvfb mesa-utils libgl1-mesa-dri mesa-vulkan-drivers vulkan-tools xauth \
    && rm -rf /var/lib/apt/lists/*

# Godot (.NET build)
RUN curl -fL -o /tmp/godot.zip \
      "https://github.com/godotengine/godot-builds/releases/download/${GODOT_VERSION}-stable/Godot_v${GODOT_VERSION}-stable_mono_linux_x86_64.zip" \
    && unzip /tmp/godot.zip -d /opt \
    && mv "/opt/Godot_v${GODOT_VERSION}-stable_mono_linux_x86_64" /opt/godot \
    && ln -s "/opt/godot/Godot_v${GODOT_VERSION}-stable_mono_linux.x86_64" /usr/local/bin/godot \
    && rm /tmp/godot.zip

RUN set -eux; \
    if ! getent group ${GID} >/dev/null; then \
        groupadd -g ${GID} ${USERNAME}; \
    fi; \
    if getent passwd ${UID} >/dev/null; then \
        existing="$(getent passwd ${UID} | cut -d: -f1)"; \
        usermod -l ${USERNAME} -d /home/${USERNAME} -m -s /bin/bash "${existing}"; \
        usermod -g ${GID} ${USERNAME}; \
    else \
        useradd -m -u ${UID} -g ${GID} -s /bin/bash ${USERNAME}; \
    fi

RUN mkdir -p /usr/share/dotnet/metadata/workloads \
    && chown -R ${UID}:${GID} /usr/share/dotnet/metadata

USER ${USERNAME}
ENV HOME=/home/${USERNAME}
WORKDIR /workspace

# Export templates (mono variant)
RUN mkdir -p ${HOME}/.local/share/godot/export_templates \
    && curl -fL -o /tmp/templates.tpz \
      "https://github.com/godotengine/godot-builds/releases/download/${GODOT_VERSION}-stable/Godot_v${GODOT_VERSION}-stable_mono_export_templates.tpz" \
    && unzip /tmp/templates.tpz -d /tmp/tpl \
    && mv /tmp/tpl/templates "${HOME}/.local/share/godot/export_templates/${GODOT_VERSION}.stable.mono" \
    && rm -rf /tmp/templates.tpz /tmp/tpl

# Claude Code
RUN curl -fsSL https://claude.ai/install.sh | bash

ENV PATH="${HOME}/.local/bin:${PATH}" \
    CLAUDE_CONFIG_DIR="${HOME}/.claude" \
    DOTNET_CLI_TELEMETRY_OPTOUT=1 \
    DOTNET_CLI_WORKLOAD_UPDATE_NOTIFY_DISABLE=1 \
    DOTNET_NOLOGO=1

CMD ["/bin/bash"]